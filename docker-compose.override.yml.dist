services:
  nextjs:
    build:
      context: .
      target: development
    image: nextjs:latest
    command: sh -c "yarn prisma generate && yarn dev"
    ports:
      - "3001:3000"   # App visible en http://localhost:3001
    environment:
      - NEXT_PUBLIC_API_URL=http://localhost:3001
    volumes:
      - .:/app                # Monta el código
      - /app/node_modules     # Evita pisar node_modules
    depends_on:
      - mysql
    networks:
      - app_network

  mysql:
    image: mysql:8.0
    container_name: mysql-db
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
      MYSQL_DATABASE: ${DB_DATABASE}
      MYSQL_USER: ${DB_USER}
      MYSQL_PASSWORD: ${DB_PASSWORD}
    ports:
      - "3307:3306"
    volumes:
      - mysql-data:/var/lib/mysql
      - ./mysql:/docker-entrypoint-initdb.d
    networks:
      - app_network

  adminer:
    image: adminer:latest
    container_name: adminer
    environment:
      ADMINER_DEFAULT_SERVER: mysql
      ADMINER_DESIGN: dracula
    ports:
      - "8081:8080"
    depends_on:
      - mysql
    networks:
      - app_network

networks:
  app_network:
    driver: bridge

volumes:
  mysql-data:
    driver: local
