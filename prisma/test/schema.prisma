// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_NON_POOLING")
}

model User {
  id                                  Int                                 @id @default(autoincrement())
  uuid                                String                              @unique @default(uuid())
  username                            String                              @unique
  password                            String
  set_password_key                    String?
  must_change_password                Boolean                             @default(false)
  active                              Boolean                             @default(true)
  created_at                          DateTime?                           @default(now())
  updated_at                          DateTime?                           @updatedAt
  employee                            Employee?
  employee_id                         Int?
  role_id                             Int
  role                                Role                                @relation(fields: [role_id], references: [id])
  attendances_created_by              EmployeeAttendance[]
  created_by                          User?                               @relation("UserCreatedBy", fields: [created_by_id], references: [id])
  created_by_id                       Int?
  users_created                       User[]                              @relation("UserCreatedBy")
  employee_requests_by                EmployeeRequest[]                   @relation("requestedBy")
  leaders_by                          AdministrativeOrganizationLeaders[] @relation("createdBy")
  employee_attendance_type_created_by EmployeeAttendanceType[]            @relation("createdByEmployeeAttendanceType")
  employee_ascriptions                EmployeeAscriptions[]               @relation("createdBy")
  user_direcciones                    UserDireccion[]
  system_logs_performed               SystemLogs[]                        @relation("SystemLogsPerformedBy")
  system_logs_affected                SystemLogs[]                        @relation("SystemLogsAffectedUser")
}

model Employee {
  id                                   Int                                 @id @default(autoincrement())
  number_employee                      String                              @unique
  name                                 String
  paternal_last_name                   String
  maternal_last_name                   String
  birthday                             DateTime?
  rfc                                  String                              @unique
  curp                                 String
  antiguedad_start_date DateTime?
  active                               Boolean                             @default(true)
  created_at                           DateTime?                           @default(now())
  updated_at                           DateTime?                           @updatedAt
  user                                 User                                @relation(fields: [user_id], references: [id])
  user_id                              Int                                 @unique
  status_employee                      StatusEmployee                      @relation(fields: [status_employee_id], references: [id])
  status_employee_id                   Int
  gender                               Gender?                              @relation(fields: [gender_id], references: [id])
  gender_id                            Int?
  employee_hiring                      EmployeeHiring[]
  employee_location                    EmployeeLocation[]
  employee_attendance_type             EmployeeAttendanceType[]
  director_id                          Int?                                @unique
  director                             Director?                           @relation("Director", fields: [director_id], references: [id])
  sustitute_id                         Int?                                @unique
  sustitute                            Director?                           @relation("Substitute", fields: [sustitute_id], references: [id])
  employee_incidents                   EmployeeIncidents[]
  employee_incidents_created_by        EmployeeIncidents[]                 @relation("createdByEmployeeIncidents")
  employee_incidents_validated_by      EmployeeIncidents[]                 @relation("validatedByEmployeeIncidents")
  employee_incidents_status_created_by EmployeeIncidentsStatus[]           @relation("createdByEmployee")
  employee_request_status_created_by   EmployeeRequestStatus[]             @relation("createdByEmployee")
  employee_requests                    EmployeeRequest[]
  employee_requests_resolved_by        EmployeeRequest[]                   @relation("resolvedBy")
  employee_created_by                  EmployeeHiring[]                    @relation("EmployeeCreatedBy")
  employee_address                     EmployeeAddress[]
  marital_status                       MaritalStatus?                      @relation(fields: [marital_status_id], references: [id])
  marital_status_id                    Int?
  schooling                            Schooling?                          @relation(fields: [schooling_id], references: [id])
  schooling_id                         Int?
  profession                           Profession?                         @relation(fields: [profession_id], references: [id])
  profession_id                        Int?
  occupation                           Occupation?                         @relation(fields: [occupation_id], references: [id])
  occupation_id                        Int?
  identification_type                  IdentificationType?                 @relation(fields: [identification_type_id], references: [id])
  identification_type_id               Int?
  employee_trade_union                 EmployeeTradeUnion[]
  trade_union_id                       Int?
  identification_folio                 String?
  job_schedule_employee                JobScheduleEmployee[]
  leaders                              AdministrativeOrganizationLeaders[]
  employee_ascriptions                 EmployeeAscriptions[]
  employee_attendance                  EmployeeAttendance[]

  job_schedule_calendar JobScheduleCalendar[]

  JobScheduleCalendar JobScheduleCalendar[] @relation("createdByEmployee")
}

model EmployeeAddress {
  id              Int           @id @default(autoincrement())
  employee_id     Int
  address_line_1  String?
  address_line_2  String?
  address_line_3  String?
  address_line_4  String?
  postal_code     String?
  postal_code_sat String?
  municipality_id Int?
  active          Boolean       @default(true)
  created_by      Int?
  created_at      DateTime?     @default(now())
  updated_at      DateTime?     @updatedAt
  employee        Employee?     @relation(fields: [employee_id], references: [id])
  municipality    Municipality? @relation(fields: [municipality_id], references: [id])
}

model EmployeeHiring {
  id               Int          @id @default(autoincrement())
  employee_id      Int
  start_job_date   DateTime
  end_job_date     DateTime?
  category_id      Int?
  employee_type_id Int?
  direccion_id     Int?
  active           Boolean      @default(true)
  created_by       Int?
  created_at       DateTime?    @default(now())
  updated_at       DateTime?    @updatedAt
  category         Category?    @relation(fields: [category_id], references: [id])
  employee_type    EmployeeType? @relation(fields: [employee_type_id], references: [id])
  direccion        Direccion?    @relation(fields: [direccion_id], references: [id])
  employee         Employee?    @relation(fields: [employee_id], references: [id])
  created_by_user  Employee?    @relation("EmployeeCreatedBy", fields: [created_by], references: [id])

  @@unique([employee_id, category_id, direccion_id, employee_type_id, active])
}

model EmployeeTradeUnion {
  id             Int         @id @default(autoincrement())
  trade_union_id Int
  employee_id    Int
  start          DateTime?
  end            DateTime?
  active         Boolean     @default(true)
  created_by     Int?
  created_at     DateTime?   @default(now())
  updated_at     DateTime?   @updatedAt
  trade_union    TradeUnion? @relation(fields: [trade_union_id], references: [id])
  employee       Employee?   @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, trade_union_id, active])
}

model EmployeeLocation {
  id                  Int                  @id @default(autoincrement())
  employee_id         Int
  location_id         Int
  commission_id       Int?
  active              Boolean              @default(true)
  created_by          Int?
  created_at          DateTime?            @default(now())
  updated_at          DateTime?            @updatedAt
  applied_at          DateTime?
  employee_attendance EmployeeAttendance[]
  location            Location?            @relation(fields: [location_id], references: [id])
  employee            Employee?            @relation(fields: [employee_id], references: [id])
  employee_commission EmployeeCommission?  @relation(fields: [commission_id], references: [id])
}

model EmployeeAttendanceType {
  id                  Int                  @id @default(autoincrement())
  employee_id         Int
  attendance_id       Int
  active              Boolean              @default(true)
  created_by_id       Int?
  created_by          User?                @relation("createdByEmployeeAttendanceType", fields: [created_by_id], references: [id])
  created_at          DateTime?            @default(now())
  updated_at          DateTime?            @updatedAt
  applied_at          DateTime?
  attendance          Attendance?          @relation(fields: [attendance_id], references: [id])
  employee            Employee?            @relation(fields: [employee_id], references: [id])
  employee_attendance EmployeeAttendance[]
}

model EmployeeCommission {
  id                   Int                @id @default(autoincrement())
  employee_request     EmployeeRequest    @relation(fields: [employee_request_id], references: [id])
  employee_request_id  Int                @unique
  employee_location_id Int
  employee_location    EmployeeLocation[]
  start_date           DateTime
  end_date             DateTime
  active               Boolean            @default(true)
  created_at           DateTime?          @default(now())
  updated_at           DateTime?          @updatedAt

  @@unique([employee_location_id, start_date, end_date, active])
}

model Director {
  id            Int       @id @default(autoincrement())
  direccion_id  Int
  employee_id   Int
  substitute_id Int
  profesion     String
  direccion     Direccion @relation(fields: [direccion_id], references: [id])
  employee      Employee? @relation("Director")
  substitute    Employee? @relation("Substitute")
  active        Boolean   @default(true)
  start_date    DateTime
  end_date      DateTime
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt

  @@unique([direccion_id, employee_id, substitute_id, active])
}

model Attendance {
  id                          Int                      @id @default(autoincrement())
  name                        String
  display_name                String
  active                      Boolean                  @default(true)
  created_at                  DateTime?                @default(now())
  updated_at                  DateTime?                @updatedAt
  employee_request_detail     EmployeeRequestDetail[]  @relation("currentAttendance")
  employee_request_detail_new EmployeeRequestDetail[]  @relation("newAttendance")
  employee_attendance_type    EmployeeAttendanceType[]
}

model EmployeeAttendance {
  id                          Int                    @id @default(autoincrement())
  employee_id                 Int
  employee                    Employee                  @relation(fields: [employee_id], references: [id])
  check_in                    DateTime?
  check_out                   DateTime?
  active                      Boolean                @default(true)
  created_by_id               Int
  employee_ascription_id      Int
  description                 String
  created_by                  User                   @relation(fields: [created_by_id], references: [id])
  employee_attendance_type_id Int
  employee_attendance_type    EmployeeAttendanceType @relation(fields: [employee_attendance_type_id], references: [id])
  employee_location_id        Int
  employee_location           EmployeeLocation       @relation(fields: [employee_location_id], references: [id])
  employee_ascriptions        EmployeeAscriptions    @relation(fields: [employee_ascription_id], references: [id])
  created_at                  DateTime?              @default(now())
  udpated_at                  DateTime?              @updatedAt

  employee_attendance_incident EmployeeAttendanceIncident[]

  job_schedule_employee_id Int?
  job_schedule_employee JobScheduleEmployee? @relation(fields: [job_schedule_employee_id], references: [id])

  job_schedule_calendar_id Int?
  job_schedule_calendar JobScheduleCalendar? @relation(fields: [job_schedule_calendar_id], references: [id])
}

model EmployeeIncidents {
  id                        Int                       @id @default(autoincrement())
  folio                     String                    @unique
  oficio                    String?
  start_date                DateTime
  end_date                  DateTime
  description               String
  incident_id               Int
  incident                  Incident                  @relation(fields: [incident_id], references: [id])
  incident_status_id        Int
  incident_status           IncidentStatus            @relation(fields: [incident_status_id], references: [id])
  employee_id               Int
  employee                  Employee                  @relation(fields: [employee_id], references: [id])
  employee_incident_days    EmployeeIncidentDays[]
  created_by_id             Int
  created_by                Employee                  @relation("createdByEmployeeIncidents", fields: [created_by_id], references: [id])
  created_at                DateTime?                 @default(now())
  validated_at              DateTime?                 @updatedAt
  validated_by_id           Int?
  validated_by              Employee?                 @relation("validatedByEmployeeIncidents", fields: [validated_by_id], references: [id])
  employee_incidents_status EmployeeIncidentsStatus[]
  direccion_id              Int?
  direccion                 Direccion?                @relation("direccion", fields: [direccion_id], references: [id])
  active                    Boolean                   @default(true)

  @@unique([employee_id, start_date, end_date, incident_status_id, incident_id])
  employee_attendance_incident EmployeeAttendanceIncident[]
}

model EmployeeAttendanceIncident {
  id Int @id @default(autoincrement())
  employee_attendance_id Int
  employee_incident_id Int
  employee_attendance EmployeeAttendance @relation(fields: [employee_attendance_id], references: [id])
  employee_incident EmployeeIncidents @relation(fields: [employee_incident_id], references: [id])
  created_at DateTime @default(now())
}

model EmployeeIncidentsStatus {
  id                   Int               @id @default(autoincrement())
  employee_incident_id Int
  employee_incident    EmployeeIncidents @relation(fields: [employee_incident_id], references: [id])
  incident_status_id   Int
  incident_status      IncidentStatus    @relation(fields: [incident_status_id], references: [id])
  active               Boolean           @default(true)
  created_by_id        Int
  created_by           Employee          @relation("createdByEmployee", fields: [created_by_id], references: [id])
  created_at           DateTime?         @default(now())
  updated_at           DateTime?         @updatedAt
}

model Incident {
  id                          Int                         @id @default(autoincrement())
  name                        String                      @unique
  display_name                String
  type                        Int
  display_calendar_dates      Boolean                     @default(false)
  display_time_on_calendar    Boolean                     @default(false)
  allow_bulk_creation         Boolean                     @default(false)
  bgColorOnCalendar           String?
  colorOnCalendar             String?
  active                      Boolean
  employee_incidents          EmployeeIncidents[]
  incidents_roles_permissions IncidentsRolesPermissions[]
  incident_rules           IncidentRules[]
}

model IncidentStatus {
  id                        Int                       @id @default(autoincrement())
  name                      String                    @unique
  display_name              String
  btn_display_name          String
  btn_icon                  String
  btn_color                 String
  type                      Int
  active                    Boolean
  employee_incidents_status EmployeeIncidentsStatus[]
  employee_incidents        EmployeeIncidents[]
  permission_name           String?
}

model Vacation {
  id         Int     @id @default(autoincrement())
  years_from Int
  years_to   Int
  days       Int
  active     Boolean @default(true)
}

model IncidentRules {
  id               Int      @id @default(autoincrement())
  incident_id      Int
  incident         Incident @relation(fields: [incident_id], references: [id])
  employee_type_id Int
  employee_type    EmployeeType @relation(fields: [employee_type_id], references: [id])
  days             Int
  start_date       Int?
  end_date         Int?
  min_years        Int      @default(0)
  max_years        Int?
  active           Boolean  @default(true)
}

model EmployeeIncidentDays {
  id                   Int               @id @default(autoincrement())
  date                 DateTime
  value                Int               @default(1)
  percentage_salary    Int               @default(0)
  employee_incident_id Int
  employee_incident    EmployeeIncidents @relation(fields: [employee_incident_id], references: [id])
  created_at           DateTime?         @default(now())
  updated_at           DateTime?         @updatedAt
}

model Request {
  id                Int               @id @default(autoincrement())
  name              String
  display_name      String
  description       String
  active            Boolean           @default(true)
  employee_requests EmployeeRequest[]
  requests_roles_permissions RequestsRolesPermissions[]
}

model RequestStatus {
  id                      Int                     @id @default(autoincrement())
  name                    String
  display_name            String
  description             String
  btn_display_name        String
  btn_icon                String
  btn_color               String
  type                    Int
  active                  Boolean                 @default(true)
  allowed_roles_to_update String
  permission_name         String?
  employee_requests       EmployeeRequest[]
  employee_request_status EmployeeRequestStatus[]
}

model EmployeeRequest {
  id                      Int                       @id @default(autoincrement())
  folio                   String                    @unique
  oficio                  String?
  description             String
  employee_id             Int
  request_id              Int
  request_status_id       Int
  request_date            DateTime
  requested_by_id         Int
  resolved_by_id          Int?
  resolved_at             DateTime?
  created_at              DateTime?                 @default(now())
  updated_at              DateTime?                 @updatedAt
  active                  Boolean                   @default(true)
  employee                Employee                  @relation(fields: [employee_id], references: [id])
  request                 Request                   @relation(fields: [request_id], references: [id])
  request_status          RequestStatus             @relation(fields: [request_status_id], references: [id])
  requested_by            User                      @relation("requestedBy", fields: [requested_by_id], references: [id])
  resolved_by             Employee?                 @relation("resolvedBy", fields: [resolved_by_id], references: [id])
  employee_request_detail EmployeeRequestDetail[]
  EmployeeRequestStatus   EmployeeRequestStatus[]
  EmployeeRequestSchedule EmployeeRequestSchedule[]
  employee_commission_id  Int?                      @unique
  employee_commission     EmployeeCommission?

  @@unique([employee_id, request_id, request_date, request_status_id, resolved_at, active])
}

model EmployeeRequestDetail {
  id                  Int             @id @default(autoincrement())
  start_date          DateTime?
  end_date            DateTime?
  attendance_date     DateTime?
  employee_request_id Int
  employee_request    EmployeeRequest @relation(fields: [employee_request_id], references: [id])
  direccion_id        Int?
  direccion           Direccion?      @relation("currentDireccion", fields: [direccion_id], references: [id])
  new_direccion_id    Int?
  new_direccion       Direccion?      @relation("newDireccion", fields: [new_direccion_id], references: [id])
  location_id         Int?
  location            Location?       @relation("currentLocation", fields: [location_id], references: [id])
  attendance_id       Int?
  attendance          Attendance?     @relation("currentAttendance", fields: [attendance_id], references: [id])
  new_location_id     Int?
  new_location        Location?       @relation("newLocation", fields: [new_location_id], references: [id])
  new_attendance_id   Int?
  new_attendance      Attendance?     @relation("newAttendance", fields: [new_attendance_id], references: [id])
}

model EmployeeRequestStatus {
  id                  Int             @id @default(autoincrement())
  employee_request_id Int
  employee_request    EmployeeRequest @relation(fields: [employee_request_id], references: [id])
  request_status_id   Int
  request_status      RequestStatus   @relation(fields: [request_status_id], references: [id])
  active              Boolean         @default(true)
  created_by_id       Int
  created_by          Employee        @relation("createdByEmployee", fields: [created_by_id], references: [id])
  created_at          DateTime?       @default(now())
  updated_at          DateTime?       @updatedAt
}

model EmployeeRequestSchedule {
  id                  Int             @id @default(autoincrement())
  employee_request_id Int
  employee_request    EmployeeRequest @relation(fields: [employee_request_id], references: [id])
  active              Boolean         @default(true)
  created_at          DateTime?       @default(now())
  updated_at          DateTime?       @updatedAt
  start_day_id        Int
  end_day_id          Int
  start_day           Day             @relation("StartDay", fields: [start_day_id], references: [id])
  end_day             Day             @relation("EndDay", fields: [end_day_id], references: [id])
  start_hour_id       Int
  end_hour_id         Int
  start_hour          Hour            @relation("StartHour", fields: [start_hour_id], references: [id])
  end_hour            Hour            @relation("EndHour", fields: [end_hour_id], references: [id])
}

model JobScheduleEmployee {
  id            Int       @id @default(autoincrement())
  employee_id   Int
  employee      Employee  @relation(fields: [employee_id], references: [id])
  name          String
  description   String
  active        Boolean   @default(true)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
  start_day_id  Int
  end_day_id    Int
  start_day     Day       @relation("StartDay", fields: [start_day_id], references: [id])
  end_day       Day       @relation("EndDay", fields: [end_day_id], references: [id])
  start_hour_id Int
  end_hour_id   Int
  start_hour    Hour      @relation("StartHour", fields: [start_hour_id], references: [id])
  end_hour      Hour      @relation("EndHour", fields: [end_hour_id], references: [id])

  employee_attendance EmployeeAttendance[]
}

model JobScheduleCalendar {
  id                 Int                 @id @default(autoincrement())
  employee_id        Int
  date               DateTime
  check_in        DateTime
  check_out       DateTime
  start_hour_id Int
  end_hour_id   Int
  start_hour    Hour      @relation("StartHour", fields: [start_hour_id], references: [id])
  end_hour      Hour      @relation("EndHour", fields: [end_hour_id], references: [id])
  employee           Employee            @relation(fields: [employee_id], references: [id])
  created_by_id       Int
  created_by          Employee        @relation("createdByEmployee", fields: [created_by_id], references: [id])
  active        Boolean   @default(true)
  created_at    DateTime? @default(now())

  employee_attendance EmployeeAttendance[]

  @@index([employee_id, date, active])
}

model Day {
  id                              Int                       @id @default(autoincrement())
  name                            String                    @unique
  display_name                    String
  active                          Boolean                   @default(true)
  job_schedule_employees_start    JobScheduleEmployee[]     @relation("StartDay")
  job_schedule_employees_end      JobScheduleEmployee[]     @relation("EndDay")
  employee_request_start_schedule EmployeeRequestSchedule[] @relation("StartDay")
  employee_request_end_schedule   EmployeeRequestSchedule[] @relation("EndDay")
}

model Hour {
  id                              Int                       @id @default(autoincrement())
  name                            String                    @unique
  display_name                    String
  active                          Boolean                   @default(true)
  job_schedule_employees_start    JobScheduleEmployee[]     @relation("StartHour")
  job_schedule_employees_end      JobScheduleEmployee[]     @relation("EndHour")
  employee_request_start_schedule EmployeeRequestSchedule[] @relation("StartHour")
  employee_request_end_schedule   EmployeeRequestSchedule[] @relation("EndHour")
  job_schedule_calendar_start JobScheduleCalendar[] @relation("StartHour")
  job_schedule_calendar_end JobScheduleCalendar[] @relation("EndHour")
}

model Role {
  id           Int                                 @id @default(autoincrement())
  name         String                              @unique
  display_name String
  description  String
  active       Boolean                             @default(true)
  users        User[]
  roleModules  RoleModule[]
  leaders      AdministrativeOrganizationLeaders[]

  incidents_roles_permissions IncidentsRolesPermissions[]
  requests_roles_permissions RequestsRolesPermissions[]
}

model Module {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  display_name String
  route        String
  icon         String
  active       Boolean      @default(true)
  parent_id    Int?
  parent       Module?      @relation("ModuleParent", fields: [parent_id], references: [id])
  children     Module[]     @relation("ModuleParent")
  roleModules  RoleModule[]
}

model RoleModule {
  id         Int      @id @default(autoincrement())
  role       Role     @relation(fields: [role_id], references: [id])
  role_id    Int
  module     Module   @relation(fields: [module_id], references: [id])
  module_id  Int
  can_view   Boolean  @default(true)
  can_create Boolean  @default(false)
  can_edit   Boolean  @default(false)
  can_delete Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([role_id, module_id])
}

model StatusEmployee {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  display_name String
  active       Boolean    @default(true)
  employees    Employee[]
}

model Gender {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  display_name String
  active       Boolean    @default(true)
  employees    Employee[]
}

model MaritalStatus {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  display_name String
  active       Boolean    @default(true)
  employees    Employee[]
}

model Schooling {
  id           Int        @id @default(autoincrement())
  cve_code         String?     @unique
  name         String     @unique
  display_name String
  active       Boolean    @default(true)
  employees    Employee[]
}

model Profession {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  display_name String
  active       Boolean    @default(true)
  employees    Employee[]
}

model Occupation {
  id           Int        @id @default(autoincrement())
  cve_code         String?     @unique
  name         String     @unique
  display_name String
  active       Boolean    @default(true)
  employees    Employee[]
}

model IdentificationType {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  display_name String
  active       Boolean    @default(true)
  employees    Employee[]
}

model TradeUnion {
  id                   Int                  @id @default(autoincrement())
  name                 String               @unique
  display_name         String
  active               Boolean              @default(true)
  employee_trade_union EmployeeTradeUnion[]
}

model EmployeeType {
  id                     Int              @id @default(autoincrement())
  name                   String           @unique
  display_name           String
  active                 Boolean          @default(true)
  employees              EmployeeHiring[]
  category_employee_type CategoryEmployeeType[]
  incident_rules         IncidentRules[]
}

model Category {
  id                     Int                    @id @default(autoincrement())
  name                   String                 @unique
  display_name           String                 @unique
  active                 Boolean                @default(true)
  employees              EmployeeHiring[]
  category_employee_type CategoryEmployeeType[]
}

model Location {
  id                          Int                     @id @default(autoincrement())
  name                        String                  @unique
  display_name                String                  @unique
  active                      Boolean                 @default(true)
  employee_location           EmployeeLocation[]
  employee_request_detail     EmployeeRequestDetail[] @relation("currentLocation")
  employee_request_detail_new EmployeeRequestDetail[] @relation("newLocation")
}

model Direccion {
  id                          Int                                 @id @default(autoincrement())
  name                        String                              @unique
  display_name                String
  secretaria_id               Int
  secretaria                  Secretaria                          @relation(fields: [secretaria_id], references: [id])
  active                      Boolean                             @default(true)
  created_at                  DateTime?                           @default(now())
  updated_at                  DateTime?                           @updatedAt
  employee_hiring             EmployeeHiring[]
  director                    Director[]
  leaders                     AdministrativeOrganizationLeaders[]
  employee_request_detail     EmployeeRequestDetail[]             @relation("currentDireccion")
  employee_request_detail_new EmployeeRequestDetail[]             @relation("newDireccion")
  employee_ascriptions        EmployeeAscriptions[]
  employee_incidents          EmployeeIncidents[]                 @relation("direccion")
  user_direcciones            UserDireccion[]
}

model Secretaria {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  display_name String
  active       Boolean     @default(true)
  direcciones  Direccion[]
}

model Municipality {
  id                Int               @id @default(autoincrement())
  cve_code          String?
  name              String
  display_name      String
  active            Boolean           @default(true)
  state             State             @relation(fields: [state_id], references: [id])
  state_id          Int
  employees_address EmployeeAddress[]
}

model State {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  display_name   String
  active         Boolean        @default(true)
  municipalities Municipality[]
  country        Country        @relation(fields: [country_id], references: [id])
  country_id     Int
}

model Country {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  display_name String
  active       Boolean @default(true)
  states       State[]
  state_id     Int?
}

model AdministrativeOrganizationLeaders {
  id             Int       @id @default(autoincrement())
  direccion_id   Int
  employee_id    Int
  role_id        Int
  created_by_id  Int
  active         Boolean   @default(true)
  start_date     DateTime?
  end_date       DateTime?
  sign_incidents Boolean   @default(false)
  sign_requests  Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  direccion      Direccion @relation(fields: [direccion_id], references: [id])
  employee       Employee  @relation(fields: [employee_id], references: [id])
  role           Role      @relation(fields: [role_id], references: [id])
  created_by     User      @relation("createdBy", fields: [created_by_id], references: [id])
}

model EmployeeAscriptions {
  id            Int       @id @default(autoincrement())
  direccion_id  Int?
  employee_id   Int
  created_by_id Int
  active        Boolean   @default(true)
  start_date    DateTime
  end_date      DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  direccion     Direccion? @relation(fields: [direccion_id], references: [id])
  employee      Employee  @relation(fields: [employee_id], references: [id])
  created_by    User      @relation("createdBy", fields: [created_by_id], references: [id])

  employee_attendance EmployeeAttendance[]
}

model UserDireccion {
  id            Int       @id @default(autoincrement())
  user          User      @relation(fields: [user_id], references: [id])
  user_id       Int
  direccion     Direccion @relation(fields: [direccion_id], references: [id])
  direccion_id  Int
  created_by_id Int
  active        Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model IncidentsRolesPermissions {
  id          Int      @id @default(autoincrement())
  role_id     Int
  role        Role     @relation(fields: [role_id], references: [id])
  incident_id Int
  incident    Incident @relation(fields: [incident_id], references: [id])
  can_view    Boolean  @default(false)
  can_validate  Boolean  @default(false)
  can_create  Boolean  @default(false)
  can_approve Boolean  @default(false)
  can_reject  Boolean  @default(false)
  can_cancel  Boolean  @default(false)
  can_delete  Boolean  @default(false)
  can_edit    Boolean  @default(false)
  active      Boolean  @default(true)
}

model RequestsRolesPermissions {
  id          Int     @id @default(autoincrement())
  role_id     Int
  role        Role    @relation(fields: [role_id], references: [id])
  request_id  Int
  request     Request @relation(fields: [request_id], references: [id])
  can_view    Boolean @default(false)
  can_create  Boolean @default(false)
  can_approve Boolean @default(false)
  can_reject  Boolean @default(false)
  can_cancel  Boolean @default(false)
  can_delete  Boolean @default(false)
  can_edit    Boolean @default(false)
  active      Boolean @default(true)
}

model ConfigYear {
  id                    Int                    @id @default(autoincrement())
  year                  Int                    @unique
  display_name          String?
  active                Boolean                @default(false)
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt
  category_employee_types CategoryEmployeeType[]

  incapacity_rule IncapacityRule[]
}

model CategoryEmployeeType {
  id               Int          @id @default(autoincrement())
  category_id      Int
  employee_type_id Int
  category         Category     @relation(fields: [category_id], references: [id])
  employee_type    EmployeeType @relation(fields: [employee_type_id], references: [id])
  salary           Decimal?     @default(0)
  config_year_id   Int?
  config_year      ConfigYear?  @relation(fields: [config_year_id], references: [id])
  active           Boolean      @default(true)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
}

model Holiday {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  display_name    String
  holiday_date    DateTime @unique
  validation_date DateTime @unique
  active          Boolean  @default(true)
}

model SystemLogs {
  id              Int      @id @default(autoincrement())
  type            String
  performed_by_id Int
  affected_user_id Int?    
  description     String?  
  metadata        Json?    
  created_at      DateTime @default(now())
  
  performed_by    User     @relation("SystemLogsPerformedBy", fields: [performed_by_id], references: [id])
  affected_user   User?    @relation("SystemLogsAffectedUser", fields: [affected_user_id], references: [id])

  @@index([performed_by_id], map: "SystemLogs_performed_by_id_fkey")
  @@index([affected_user_id], map: "SystemLogs_affected_user_id_fkey")
  @@index([type], map: "SystemLogs_type_idx")
  @@index([created_at], map: "SystemLogs_created_at_idx")
}

model IncapacityRule {
  id               Int     @id @default(autoincrement())
  config_year_id   Int
  min_years        Int
  max_years        Int?
  full_salary_days Int
  half_salary_days Int
  active           Boolean @default(true)

  config_year      ConfigYear @relation(fields: [config_year_id], references: [id])

  @@index([config_year_id, min_years, max_years])
}