# Usuario exclusivo ZKBio Zlink (no el del administrador RH).
# Tokens iniciales de esta cuenta. Despues se rotan en ZLINK_SESSION_FILE.
ZLINK_ACCESS_TOKEN=
ZLINK_REFRESH_TOKEN=
ZLINK_DEVICE_ID=
ZLINK_COMPANY_ID=
ZLINK_CSRF_TOKEN=
ZLINK_API_BASE_URL=https://zlink.minervaiot.com
ZLINK_TIMEZONE_HEADER=America/Mexico_City;dst=0;UTC=-06:00;
ZLINK_LOCAL_TIMEZONE=America/Mexico_City

# MySQL RH Municipio. En Docker: servicio mysql:3306; desde Mac: localhost:3307.
# No usar la base de GOJIRA Systems.
DATABASE_URL="mysql://USUARIO_RH:CLAVE_RH@mysql:3306/BASE_RH"

SYNC_EVERY_SECONDS=120
SYNC_LOOKBACK_DAYS=3
SYNC_RECONCILE_DAYS=14
SYNC_RECONCILE_HOURS=24
SYNC_PAGE_SIZE=100
SYNC_MAX_PAGES_PER_DAY=1000
SYNC_REQUEST_DELAY_MS=100
SYNC_TIMEOUT_MS=15000
SYNC_REFRESH_MARGIN_SECONDS=300
SYNC_RETRIES=3

# En Docker las dos rutas se establecen en docker-compose.zlink.yml.
# Para pruebas locales, omitir estas dos variables.
# ZLINK_SESSION_FILE=/app/state/session.json
# ZLINK_LOCK_FILE=/app/state/sync.lock
